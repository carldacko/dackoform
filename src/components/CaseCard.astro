---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="card" href={`/work/${entry.id}/`}>
  <Image src={d.cover} alt={d.coverAlt} widths={[480, 800, 1200]} sizes="(min-width: 50rem) 50vw, 100vw" />
  <h3>{d.title}</h3>
  <p class="muted">{d.services.join(', ')}</p>
</a>
<style>
  .card { text-decoration: none; display: block; }
  .card :global(img) { aspect-ratio: 3 / 2; object-fit: cover; width: 100%; }
  h3 { margin: 0.75rem 0 0.25rem; font-size: var(--step-1); }
  p { margin: 0; }
</style>
