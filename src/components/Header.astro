---
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="wrap">
  <a href="/" class="logo">Dackoform</a>
  <nav aria-label="Main">
    {nav.map((item) => (
      <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>
<style>
  header { display: flex; justify-content: space-between; align-items: baseline; padding-block: 1.5rem 3rem; }
  .logo { font-weight: 600; text-decoration: none; }
  nav { display: flex; gap: 1.5rem; }
  nav a { text-decoration: none; }
  nav a[aria-current='page'] { text-decoration: underline; }
</style>
