---
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { getWork } from '../../../lib';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---
<Base title={d.title} description={d.summary} image={og.src}>
  <article>
    <header>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <dl>
        <div><dt>Client</dt><dd>{d.client}</dd></div>
        <div><dt>Year</dt><dd>{d.year}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        {d.services.length > 0 && <div><dt>Services</dt><dd>{d.services.join(', ')}</dd></div>}
      </dl>
    </header>
    <Image src={d.cover} alt={d.coverAlt} widths={[800, 1200, 1800]} sizes="100vw" loading="eager" />
    <div class="body"><Content /></div>
    {d.quote && (
      <blockquote>
        <p>{d.quote.text}</p>
        <footer>{d.quote.name}, {d.quote.title}</footer>
      </blockquote>
    )}
    <p><a href="/work/">All work</a></p>
  </article>
</Base>
<style>
  .lede { font-size: var(--step-1); max-width: 45rem; }
  dl { display: flex; flex-wrap: wrap; gap: 1rem 3rem; margin: 2rem 0 3rem; }
  dt { color: var(--muted); font-size: 0.875em; }
  dd { margin: 0; }
  .body { max-width: 42rem; margin-block: 3rem; }
  blockquote { margin: 4rem 0; font-size: var(--step-1); max-width: 45rem; }
  blockquote footer { font-size: var(--step-0); color: var(--muted); margin-top: 1rem; }
</style>
