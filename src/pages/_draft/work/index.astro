---
import Base from '../../../layouts/Base.astro';
import CaseCard from '../../../components/CaseCard.astro';
import { getWork } from '../../../lib';
const work = await getWork();
---
<Base title="Work" description="Selected work by Dackoform: identity, type, copy and websites for Nordic and international brands.">
  <h1>Work</h1>
  <div class="grid">{work.map((entry) => <CaseCard entry={entry} />)}</div>
</Base>
<style>
  .grid { display: grid; gap: 3rem 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
</style>
